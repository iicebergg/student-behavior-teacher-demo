{
  "name": "solace-behavioral-insights",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Teacher-facing demo of student testing behavior and question topics across a practice test, built on the SOLace behavioral-state encoding.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "signal": "vite-node scripts/inspect.ts",
    "sweep": "vite-node scripts/sweep.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.ts\""
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
